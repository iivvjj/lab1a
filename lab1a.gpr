with "config/lab1a_config.gpr";
project Lab1a is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Lab1a_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("lab1a.adb", "producerconsumer_prot.adb",
      "producerconsumer_rndzvs.adb", "producerconsumer_sem.adb");


   package Compiler is
      for Default_Switches ("Ada") use Lab1a_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Lab1a;
